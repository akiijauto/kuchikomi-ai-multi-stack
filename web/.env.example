# Anthropic APIキー(未設定の場合はデモモードで動作)
ANTHROPIC_API_KEY=

# 生成モデル(省略時: claude-sonnet-4-6 / コスト調整時: claude-haiku-4-5)
GENERATION_MODEL=

# Supabase(会員登録・プロフィール・利用回数管理に使用)
# Supabaseダッシュボードの Project Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SupabaseのService Role Key(Stripe Webhookなど管理者処理に使用。秘匿情報)
# Supabaseダッシュボードの Project Settings > API から取得
SUPABASE_SERVICE_ROLE_KEY=

# Stripe(課金機能に使用)
# Stripeダッシュボードの 開発者 > APIキー から取得
STRIPE_SECRET_KEY=
# Stripeダッシュボードの 開発者 > Webhook で作成したエンドポイントの署名シークレット
STRIPE_WEBHOOK_SECRET=
# プロプラン(月額980円)用のPrice ID(商品 > 価格 から取得)
STRIPE_PRICE_ID_PRO=

# 特定商取引法に基づく表記・各種法定ページに表示する運営者情報
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_EMAIL=
# 任意。未設定の場合は「ご請求があれば遅滞なく開示します」と表示されます
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_OPERATOR_PHONE=

# note下書き生成(社内ツール、/admin/note-draft)に使用。Google AI Studio https://aistudio.google.com/apikey で無料発行可
GEMINI_API_KEY=
# 省略時: gemini-2.5-flash-lite
GEMINI_MODEL=
# /admin/note-draft へのアクセスを許可するオーナー自身のログインメールアドレス
ADMIN_EMAIL=

# アクセス解析・広告計測(任意。未設定なら計測タグは読み込まれない)
# GA4の測定ID(G-XXXXXXXXXX)。GA4管理画面 > データストリーム から取得
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Meta(Facebook)ピクセルID。Meta Events Manager から取得
NEXT_PUBLIC_META_PIXEL_ID=
